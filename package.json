{
  "name": "dsh-task-atlas",
  "version": "0.0.1",
  "description": "Project breakdown + structured task tree for DeepSeek Harness: a pinned right-sidebar tree with status semantics (rework / blocked / dropped, each with a reason), explicit branch provenance, prerequisites with what they provide, and re-openable outputs per node.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ateen18/dsh-task-atlas.git"
  },
  "homepage": "https://github.com/ateen18/dsh-task-atlas#readme",
  "bugs": {
    "url": "https://github.com/ateen18/dsh-task-atlas/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.0",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "~5.7.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-client-bundle.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "prepare": "tsdown && node scripts/check-client-bundle.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "deepseek-harness",
    "task-tree",
    "project-breakdown"
  ]
}
